# ---- Python / environments ----
venv/
.venv/
venv_py310_backup/
__pycache__/
*.pyc
.pytest_cache/

# ---- Local secrets / config (copy the *.example.yaml files) ----
config.yaml
dubflow.yaml
.env
.env.*
browser_profile/
login_gemini.bat
