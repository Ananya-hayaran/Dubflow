# ---- Generated data (DubFlow pipeline) ----
# Keep the folders in Git via .gitkeep, ignore everything generated inside.
data/downloads/*
data/intermediate/*
data/output/*
!data/downloads/.gitkeep
!data/intermediate/.gitkeep
!data/output/.gitkeep

# ---- Legacy AutoDubVN generated files ----
/downloads/
/output/
*.log
*.bak*
.cursor/

# ---- Large media / local tools ----
assets/nhac_nen/*.mp3
assets/nhac_nen/*.flac
assets/nhac_nen/*.wav
tools/
